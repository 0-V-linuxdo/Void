{
    "name": "void",
    "version": "1.0.2.8",
    "description": "A modification for grok.com",
    "homepage": "https://github.com/imjustprism/Void#readme",
    "bugs": {
        "url": "https://github.com/imjustprism/Void/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/imjustprism/Void.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "Prism",
    "type": "module",
    "scripts": {
        "build": "bun run build.ts",
        "build:dev": "bun run build.ts --dev",
        "watch": "bun run build.ts --watch",
        "lint": "oxlint -c .oxlintrc.json src && eslint",
        "lint:fix": "oxlint -c .oxlintrc.json --fix src && eslint --fix",
        "lint:oxlint": "oxlint -c .oxlintrc.json src",
        "lint:oxlint:fix": "oxlint -c .oxlintrc.json --fix src",
        "lint:eslint": "eslint",
        "lint:eslint:fix": "eslint --fix",
        "lint:styles": "stylelint \"src/**/*.css\"",
        "lint:styles:fix": "stylelint \"src/**/*.css\" --fix",
        "tsc": "tsc --noEmit",
        "mcp": "bun run src/plugins/mcp.dev/server.ts",
        "reporter": "bun run reporter.ts"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.9.0",
        "@types/bun": "1.3.10",
        "@types/react": "19.2.14",
        "eslint": "10.0.2",
        "eslint-plugin-simple-header": "1.2.2",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "eslint-plugin-unused-imports": "4.4.1",
        "oxlint": "1.59.0",
        "stylelint": "17.4.0",
        "stylelint-config-standard": "40.0.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.56.1"
    },
    "engines": {
        "bun": ">=1.1"
    }
}
