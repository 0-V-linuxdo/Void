{
    "manifest_version": 3,
    "minimum_chrome_version": "111",
    "name": "Void",
    "description": "The cutest mod for grok",
    "author": "Void Contributors",
    "homepage_url": "https://github.com/imjustprism/Void",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": [
        "*://grok.com/*",
        "*://x.ai/*",
        "*://*.x.ai/*"
    ],
    "permissions": [
        "declarativeNetRequest",
        "cookies"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": [
                "*://grok.com/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": false,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": [
                "*://grok.com/*"
            ],
            "js": [
                "Void.js"
            ],
            "all_frames": false,
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "Void.js"
            ],
            "matches": [
                "*://grok.com/*"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "modifyResponseHeaders",
                "enabled": true,
                "path": "modifyResponseHeaders.json"
            }
        ]
    }
}
